{
  "name": "rule-harvester",
  "version": "2.18.0",
  "description": "RuleHarvester is a rules engine for javascript",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "files": [
    "build/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GiganticPlayground/rule-harvester.git"
  },
  "scripts": {
    "prepare": "rimraf ./build && tsc",
    "start:example": "cd examples && npm run start",
    "start:example:dev": "nodemon",
    "build": "rimraf ./build && tsc",
    "test": "mocha -r ts-node/register ./tests/**/*.test.ts"
  },
  "dependencies": {
    "@breejs/later": "^4.2.0",
    "@types/ws": "^8.18.2",
    "rules-js": "github:GiganticPlayground/rules-js#semver:^1.1.1",
    "amqp-cacoon": "github:GiganticPlayground/amqp-cacoon#semver:^3.6.0",
    "coronado-bridge": "github:GiganticPlayground/coronado-bridge#semver:^2.4.0",
    "lodash": "^4.18.1",
    "log4js": "^6.9.1",
    "mqtt": "^5.16.1",
    "p-queue": "^10.0.0"
  },
  "author": "Daniel Morris",
  "license": "MIT",
  "devDependencies": {
    "@types/amqp-connection-manager": "^3.4.5",
    "@types/amqplib": "^0.10.8",
    "@types/chai": "^5.2.3",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "ts-sinon": "^2.0.2",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.5"
  }
}
